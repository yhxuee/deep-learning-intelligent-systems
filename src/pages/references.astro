---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
const refs = (await getCollection('references')).sort(
  (a, b) => a.data.authors.localeCompare(b.data.authors) || a.data.year - b.data.year,
);
---

<StarlightPage frontmatter={{ title: 'References', description: 'Every source cited by the Core, Atlas and Mentor, with stable keys.' }}>
  <p>
    Each entry has a stable key used in Atlas front matter. The build fails if a node cites a key that is not listed here.
    Claims in the Core are classified as <em>derivation</em>, <em>experimentally supported</em>, <em>engineering observation</em>, or
    <em>open hypothesis</em> (see <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/project/governance/`}>Governance</a>).
  </p>
  <ol class="refs">
    {
      refs.map((r) => (
        <li id={r.id}>
          {r.data.authors} ({r.data.year}). {r.data.url ? <a href={r.data.url}>{r.data.title}</a> : r.data.title}. <em>{r.data.venue}</em>.{' '}
          <code>{r.id}</code>
        </li>
      ))
    }
  </ol>
</StarlightPage>

<style>
  .refs li { margin-bottom: 0.5rem; }
  .refs code { font-size: var(--sl-text-xs); }
</style>
