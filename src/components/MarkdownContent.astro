---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import UnitCard from './UnitCard.astro';
import AtlasCard from './AtlasCard.astro';
const { data } = Astro.locals.starlightRoute.entry;
---

<Default>
  {data.unit && <UnitCard unit={data.unit} />}
  {data.atlas && <AtlasCard node={data.atlas} />}
  <slot />
</Default>
