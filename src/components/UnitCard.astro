---
import { loadGraph, url, MASTERY_CLASS, MASTERY_LABEL } from '../lib/atlas';
const { unit } = Astro.props;
const { nodes } = await loadGraph();
const status = {
  complete: 'Complete — reviewed against the writing standard',
  draft: 'Full draft — awaiting subject and pedagogical review',
  outline: 'Planning outline — not yet textbook text',
}[unit.status as 'complete' | 'draft' | 'outline'];
---

<aside class="unit-card" aria-label="Unit summary">
  <p class="unit-q"><span class="unit-label">Question</span> {unit.question}</p>
  <dl>
    <dt>Anchor exemplar <small>(internalize)</small></dt>
    <dd>{unit.anchor}</dd>
    <dt>Spine-project increment</dt>
    <dd>{unit.spine}</dd>
    <dt>AI-off checkpoint</dt>
    <dd>{unit.checkpoint}</dd>
    {
      unit.atlas.length > 0 && (
        <>
          <dt>Atlas nodes</dt>
          <dd>
            {unit.atlas.map((id: string, i: number) => {
              const n = nodes.get(id)!;
              return (
                <>
                  {i > 0 && ' · '}
                  <a href={url(n.id + '/')}>{n.data.title}</a>{' '}
                  <span class={MASTERY_CLASS[n.data.atlas!.mastery]}>{MASTERY_LABEL[n.data.atlas!.mastery]}</span>
                </>
              );
            })}
          </dd>
        </>
      )
    }
  </dl>
  <p class="unit-status">Part {unit.part} · Unit {String(unit.number).padStart(2, '0')} · Status: <strong>{status}</strong></p>
</aside>

<style>
  .unit-card { border: 1px solid var(--sl-color-gray-5); border-left: 4px solid var(--sl-color-accent); border-radius: 0.5rem; padding: 1rem 1.25rem; margin-bottom: 2rem; background: var(--sl-color-gray-7, var(--sl-color-black)); }
  .unit-q { font-size: var(--sl-text-lg); font-weight: 600; margin: 0 0 0.75rem; }
  .unit-label { display: block; font-size: var(--sl-text-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--sl-color-gray-3); font-weight: 600; }
  dl { margin: 0; display: grid; gap: 0.25rem 1rem; }
  dt { font-weight: 600; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); margin-top: 0.5rem; }
  dt small { font-weight: 400; color: var(--sl-color-gray-3); }
  dd { margin: 0; font-size: var(--sl-text-sm); }
  .unit-status { margin: 0.75rem 0 0; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
</style>
