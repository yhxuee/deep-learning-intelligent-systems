---
import { getCollection } from 'astro:content';
import { pick } from '../lib/i18n';
import SC from '../data/glossary.zh-cn.json';
const locale = Astro.locals.starlightRoute.locale;
const sc = (id: string) => (SC as Record<string, { term: string }>)[id]?.term ?? '—';
const AREAS: [string, string, string, string][] = [
  ['optimization', 'Optimization (Unit 03)', '最佳化（單元 03）', '优化（单元 03）'],
  ['attention', 'Interaction and attention (Unit 04)', '交互作用與注意力（單元 04）', '交互与注意力（单元 04）'],
  ['memory', 'Memory (Unit 05)', '記憶（單元 05）', '记忆（单元 05）'],
  ['statistics', 'Statistics and learning', '統計與學習', '统计与学习'],
  ['systems', 'Systems and numerics', '系統與數值計算', '系统与数值计算'],
  ['general', 'General computing', '一般資訊用語', '通用计算术语'],
  ['book', 'This book', '本書用語', '本书用语'],
];
const all = await getCollection('glossary');
---

{
  AREAS.map(([area, en, tw, cn]) => {
    const rows = all.filter((g) => g.data.area === area).sort((a, b) => a.data.en.localeCompare(b.data.en));
    return (
      <section>
        <h2 id={`area-${area}`}>{pick(locale, en, tw, cn)}</h2>
        <table>
          <thead>
            {pick(locale,
              <tr><th>English</th><th>中文（臺灣）</th><th>简体中文（大陆）</th><th>Note (zh-TW)</th></tr>,
              <tr><th>中文（臺灣）</th><th>English</th><th>簡體中文（中國大陸）</th><th>說明</th></tr>,
              <tr><th>简体中文</th><th>English</th><th>台湾常用译法</th></tr>,
            )}
          </thead>
          <tbody>
            {rows.map((g) =>
              pick(locale,
                <tr id={g.id}><td><strong>{g.data.en}</strong></td><td lang="zh-TW">{g.data.zh}</td><td lang="zh-CN">{sc(g.id)}</td><td lang="zh-TW">{g.data.note ?? ''}</td></tr>,
                <tr id={g.id}><td><strong>{g.data.zh}</strong></td><td>{g.data.en}</td><td lang="zh-CN">{sc(g.id)}</td><td>{g.data.note ?? ''}</td></tr>,
                <tr id={g.id}><td><strong>{sc(g.id)}</strong></td><td>{g.data.en}</td><td lang="zh-TW">{g.data.zh}</td></tr>,
              ),
            )}
          </tbody>
        </table>
      </section>
    );
  })
}
