---
import { loadGraph, url, repoUrl, shortCite, titleIn, masteryLabel, MASTERY_CLASS } from '../lib/atlas';
const { node } = Astro.props;
const locale = Astro.locals.starlightRoute.locale;
import { pick } from '../lib/i18n';
const g = await loadGraph();
const { nodes, units, refs } = g;
const link = (id: string) => ({ href: url(nodes.get(id)!.id + '/', locale), title: titleIn(g, nodes.get(id)!, locale) });
const LBL = pick(locale,
  { core: 'Core units', pre: 'Prerequisites', rel: 'Related', pred: 'Historical predecessors', alt: 'Alternative mechanisms', req: 'Required by', kit: 'Verification kit', src: 'Primary sources', rev: 'Last reviewed', type: {} as Record<string, string> },
  { core: '核心單元', pre: '先備知識', rel: '相關', pred: '歷史前身', alt: '替代機制', req: '被以下節點需要', kit: '驗證工具組', src: '原始文獻', rev: '最後審閱', type: { mathematics: '數學', mechanism: '機制', architecture: '架構', method: '方法', optimizer: '最佳化器', paradigm: '範式' } as Record<string, string> },
  { core: '核心单元', pre: '先修知识', rel: '相关', pred: '历史前身', alt: '替代机制', req: '被以下节点依赖', kit: '验证工具包', src: '原始文献', rev: '最后审阅', type: { mathematics: '数学', mechanism: '机制', architecture: '架构', method: '方法', optimizer: '优化器', paradigm: '范式' } as Record<string, string> });
const groups = [
  [LBL.pre, node.prerequisites],
  [LBL.rel, node.related],
  [LBL.pred, node.predecessors],
  [LBL.alt, node.alternatives],
].filter(([, ids]) => (ids as string[]).length > 0) as [string, string[]][];
const usedBy = [...nodes.values()].filter((n) => n.data.atlas!.prerequisites.includes(node.id));
const refsHref = (k: string) => url(`references/#${k}`, locale);
---

<aside class="atlas-card" aria-label={pick(locale, 'Atlas node metadata', 'Atlas 節點資訊', 'Atlas 节点信息')}>
  <p class="row">
    <code>{node.id}</code>
    <span class="type">{LBL.type[node.type] ? `${LBL.type[node.type]}（${node.type}）` : node.type}</span>
    <span class={MASTERY_CLASS[node.mastery]}>{masteryLabel(node.mastery, locale)}</span>
  </p>
  <dl>
    {
      node.core_units.length > 0 && (
        <>
          <dt>{LBL.core}</dt>
          <dd>
            {node.core_units.map((u: number, i: number) => (
              <>
                {i > 0 && ' · '}
                <a href={url(units.get(u)!.id + '/', locale)}>{titleIn(g, units.get(u)!, locale)}</a>
              </>
            ))}
          </dd>
        </>
      )
    }
    {
      groups.map(([label, ids]) => (
        <>
          <dt>{label}</dt>
          <dd>
            {ids.map((id, i) => (
              <>
                {i > 0 && ' · '}
                <a href={link(id).href}>{link(id).title}</a>
              </>
            ))}
          </dd>
        </>
      ))
    }
    {
      usedBy.length > 0 && (
        <>
          <dt>{LBL.req}</dt>
          <dd>
            {usedBy.map((n, i) => (
              <>
                {i > 0 && ' · '}
                <a href={url(n.id + '/', locale)}>{titleIn(g, n, locale)}</a>
              </>
            ))}
          </dd>
        </>
      )
    }
    {
      node.lab && (
        <>
          <dt>{LBL.kit}</dt>
          <dd><a href={repoUrl(node.lab)}><code>{node.lab}</code></a></dd>
        </>
      )
    }
    <dt>{LBL.src}</dt>
    <dd>
      {node.references.map((k: string, i: number) => (
        <>
          {i > 0 && ' · '}
          <a href={refsHref(k)}>{shortCite(refs.get(k)!)}</a>
        </>
      ))}
    </dd>
  </dl>
  <p class="reviewed">{LBL.rev} {node.last_reviewed.toISOString().slice(0, 10)}</p>
</aside>

<style>
  .atlas-card { border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; padding: 0.9rem 1.2rem; margin-bottom: 2rem; font-size: var(--sl-text-sm); }
  .row { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin: 0 0 0.5rem; }
  .type { text-transform: uppercase; font-size: var(--sl-text-xs); letter-spacing: 0.06em; color: var(--sl-color-gray-3); font-weight: 600; }
  dl { margin: 0; }
  dt { font-weight: 600; color: var(--sl-color-gray-2); margin-top: 0.5rem; }
  dd { margin: 0; }
  .reviewed { margin: 0.75rem 0 0; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
</style>
